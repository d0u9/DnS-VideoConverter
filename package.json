{
  "name": "dns-video-converter",
  "version": "0.1.19",
  "description": "Standalone GUI for converting video to HEVC/AAC MP4 using ffmpeg",
  "main": "./out/main/index.js",
  "author": "Jane Yuan",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "dist:mac": "npm run build && electron-builder --mac --dir --publish=never",
    "dist:mac:zip": "npm run build && electron-builder --mac zip --x64 --arm64 --publish=never",
    "dist:win": "npm run build && electron-builder --win portable --publish=never"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true
  },
  "dependencies": {
    "systeminformation": "^5.33.1",
    "ws": "^8.21.3"
  }
}
